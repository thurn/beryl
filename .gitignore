/tools/.pyre/
/.pyre/
/tools/.pytest_cache/
/efficiency/.venv/
/efficiency/.pyre/
/ignite/target/
__pycache__/
*.egg-info/

# Logs and run output live in ~/Library/Caches/beryl, never here.
/out/
.DS_Store

# Ignite build trees.
/.worktrees/

.playwright-mcp/
