# Build output: Rust, Tauri's generated schemas, the UI, Python.
/rust/target/
/rust/crates/*/gen/
/ui/node_modules/
/ui/dist/
/ui/*.tsbuildinfo
# Fixture streams beryl_cli records for the UI's fixture transport; generated, never committed.
/ui/public/fixtures/
# Card art cut from docs/ui_mockups for the dev-only replicas; generated, never committed.
/ui/replica-art/
/tools/.venv/
/tools/.pyre/
/tools/.pytest_cache/
__pycache__/
*.egg-info/

# Logs and run output live in ~/Library/Caches/beryl, never here.
/out/
.DS_Store

# Enact worktrees.
/.worktrees/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
/.beads/interactions.jsonl
