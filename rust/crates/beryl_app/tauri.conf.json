{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beryl",
  "mainBinaryName": "beryl",
  "version": "0.1.0",
  "identifier": "ca.thurn.beryl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Beryl",
        "width": 1440,
        "height": 900,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: beryl-art: http://beryl-art.localhost",
        "style-src": "'self' 'unsafe-inline'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
